# Where to send waitlist signups. If unset, signups log to the server console.
#
# Slack: paste your Incoming Webhook URL. The route formats messages for Slack.
#   https://api.slack.com/messaging/webhooks
#
# Anything else (Formspree, Zapier, custom endpoint): the route POSTs
#   { "email": "...", "variant": "...", "source": "replyy-lp", "at": "ISO8601" }
#
WAITLIST_WEBHOOK_URL=
